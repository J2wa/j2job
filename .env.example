# Set in Vercel environment variables. Never commit real values.
APP_ACCESS_PASSWORD=
AI_GATEWAY_API_KEY=
# Optional first-choice model. If unset, the preferred order starts with GPT-6 Luna Fast.
RESUME_MODEL=openai/gpt-6-luna-fast

# Optional comma-separated fallback allowlist (in order). Blank uses the live compatible catalog.
RESUME_FALLBACK_MODELS=

# AI provider: auto, gateway, openrouter, gemini, or openai. Form selection can override this default.
# Auto prefers configured Gateway credentials, then OpenRouter, then native Gemini.
RESUME_PROVIDER=auto
OPENROUTER_API_KEY=
# Optional OpenRouter model and comma-separated fallback allowlist. Blank discovers models.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=

# Native Google AI Studio Gemini key (not an AI Gateway/OpenRouter key).
GEMINI_API_KEY=
# Optional model and comma-separated native Gemini model fallbacks.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=

# Multiple server-side keys: JSON array, comma-separated, or one key per line.
# Each pool is used only with the matching service. Maximum 32 unique keys per pool.
OPENAI_API_KEYS=[]
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FALLBACK_MODELS=
OPENROUTER_API_KEYS=[]
GEMINI_API_KEYS=[]
AI_GATEWAY_API_KEYS=[]
