# Set in Vercel environment variables. Never commit real values.
APP_ACCESS_PASSWORD=
AI_GATEWAY_API_KEY=
# Optional first-choice model. If unset, the preferred order starts with GPT-6 Luna Fast.
RESUME_MODEL=openai/gpt-6-luna-fast

# Optional comma-separated fallback allowlist (in order). Blank uses the live compatible catalog.
RESUME_FALLBACK_MODELS=

# AI provider: auto, gateway, or openrouter. Form selection can override this default.
# Auto uses OpenRouter when only OPENROUTER_API_KEY is configured; otherwise Gateway.
RESUME_PROVIDER=auto
OPENROUTER_API_KEY=
# Optional OpenRouter model and comma-separated fallback allowlist. Blank discovers models.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
