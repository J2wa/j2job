# Set in Vercel environment variables. Never commit real values.
APP_ACCESS_PASSWORD=

# Automatic resume routing: OpenRouter -> Gemini -> OpenAI.
# Configure any or all providers; missing providers are skipped.
# Pools accept JSON arrays, comma-separated values or one key per line.
# Maximum 32 unique keys per provider; keys stay server-side and provider-scoped.
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=[]
GEMINI_API_KEY=
GEMINI_API_KEYS=[]
OPENAI_API_KEY=
OPENAI_API_KEYS=[]

# Optional Gateway credentials for the separate career coach.
AI_GATEWAY_API_KEY=
